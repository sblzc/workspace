# GitHub 访问令牌 —— 只存在本机，永不提交
.github-token

# SSH 探测残留：里面有测试用私钥 id_ed25519。
# 这个目录删不掉（文件属主是别的安全主体，连 takeown 都拒绝），
# 所以用 ignore 保证它永远不会被提交 —— 私钥绝不入库。
_fakehome/

# 其他可能的凭据
.env
.env.*
*.pem
*.key

# Python
__pycache__/
*.py[cod]
.pipecache/
_piptest/

# Node
node_modules/
npmglobal/

# 操作系统
Thumbs.db
desktop.ini
